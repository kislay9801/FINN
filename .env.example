# No credentials are required for local mode. Copy to .env.local to configure.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# SUPABASE_ANON_KEY enables optional email/password sign-in; it is NOT the service-role key.
# Personal watchlists/settings remain browser-local, including after sign-in.
